const express = require("express");
const cors = require("cors");
const OpenAI = require("openai");

const app = express();
const port = process.env.PORT || 3000;

const openai = new OpenAI({
  apiKey: process.env.OPENAI_API_KEY
});

app.use(cors({
  origin: [
    "https://thomas-sketch91.github.io"
  ]
}));

app.use(express.json({ limit: "1mb" }));

app.get("/", (req, res) => {
  res.send("Unshaken Creator Studio API is running.");
});

app.post("/api/chat", async (req, res) => {
  try {
    const message = req.body.message;

    if (!message || typeof message !== "string") {
      return res.status(400).json({
        error: "Please provide a message."
      });
    }

    const response = await openai.responses.create({
      model: "gpt-5.5",
      instructions: "You are Unshaken Creator Studio, an AI assistant helping with YouTube strategy, video ideas, scripts, SEO, and content planning. Give practical, specific advice.",
      input: message
    });

    res.json({
      reply: response.output_text
    });

  } catch (error) {
    console.error("AI error:", error.message);
    res.status(500).json({
      error: "The AI request failed. Please try again."
    });
  }
});

app.listen(port, () => {
  console.log(`Server running on port ${port}`);
});
